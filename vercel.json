{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "git": {
    "deploymentEnabled": true
  },
  "functions": {
    "api/index.mjs": {
      "maxDuration": 30
    },
    "api/narrate-observation.mjs": {
      "maxDuration": 30
    },
    "api/interpret-transfer.mjs": {
      "maxDuration": 30
    },
    "api/resolve-hazard-flex.mjs": {
      "maxDuration": 30
    },
    "api/admin-login.mjs": {
      "maxDuration": 15
    },
    "api/admin-snapshot.mjs": {
      "maxDuration": 15
    },
    "api/admin-communications.mjs": {
      "maxDuration": 15
    },
    "api/admin-control.mjs": {
      "maxDuration": 15
    },
    "api/admin-audit.mjs": {
      "maxDuration": 15
    },
    "api/admin-session-ops.mjs": {
      "maxDuration": 15
    },
    "api/player-presence.mjs": {
      "maxDuration": 15
    },
    "api/player-admin-system.mjs": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/narrate-observation",
      "destination": "/api/narrate-observation.mjs"
    },
    {
      "source": "/api/interpret-transfer",
      "destination": "/api/interpret-transfer.mjs"
    },
    {
      "source": "/api/resolve-hazard-flex",
      "destination": "/api/resolve-hazard-flex.mjs"
    },
    {
      "source": "/api/tester-login",
      "destination": "/api/index.mjs"
    },
    {
      "source": "/api/admin-login",
      "destination": "/api/admin-login.mjs"
    },
    {
      "source": "/api/admin-snapshot",
      "destination": "/api/admin-snapshot.mjs"
    },
    {
      "source": "/api/admin-communications",
      "destination": "/api/admin-communications.mjs"
    },
    {
      "source": "/api/admin-control",
      "destination": "/api/admin-control.mjs"
    },
    {
      "source": "/api/admin-audit",
      "destination": "/api/admin-audit.mjs"
    },
    {
      "source": "/api/admin-session-ops",
      "destination": "/api/admin-session-ops.mjs"
    },
    {
      "source": "/api/player-presence",
      "destination": "/api/player-presence.mjs"
    },
    {
      "source": "/api/player-admin-system",
      "destination": "/api/player-admin-system.mjs"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.mjs"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data: blob:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://kfgtvifupumjuewwxzmz.supabase.co; base-uri 'none'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/admin-dashboard.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
